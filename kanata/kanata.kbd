(defvar
  tt 200
  ht 170
)

(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  linux-dev-names-include (
    "Pebble K380s"
  )
  macos-dev-names-include (
    "Pebble K380s"
    "Apple Internal Keyboard / Trackpad"
  )
  tap-hold-require-prior-idle 150
  movemouse-smooth-diagonals yes
  movemouse-inherit-accel-state yes
)

(defsrc
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  u
  caps a s d f g h j k l ;
  n m
  spc
)

(platform (macos)
  (defalias f1 brdn f2 brup f7 prev f8 pp f9 next f10 mute f11 vold f12 volu)
)
(platform (linux)
  (defalias f1 f1 f2 f2 f7 f7 f8 f8 f9 f9 f10 f10 f11 f11 f12 f12)
)

(defalias
  esc (tap-hold-release $tt $ht esc (caps-word 2000))

  a  (tap-hold-tap-keys $tt $ht a lmet (q w e r t s d f g z x c v b))
  s  (tap-hold-tap-keys $tt $ht s lalt (q w e r t a d f g z x c v b))
  d  (tap-hold-tap-keys $tt $ht d lctl (q w e r t a s f g z x c v b))
  f  (tap-hold-tap-keys $tt $ht f lsft (q w e r t a s d g z x c v b))

  j  (tap-hold-tap-keys $tt $ht j rsft (y u i o p k l ; h n m , . /))
  k  (tap-hold-tap-keys $tt $ht k rctl (y u i o p j l ; h n m , . /))
  l  (tap-hold-tap-keys $tt $ht l ralt (y u i o p j k ; h n m , . /))
  sc (tap-hold-tap-keys $tt $ht ; rmet (y u i o p j k l h n m , . /))

  nav (tap-hold-release $tt $ht spc (layer-while-held navigation))

  mse  (layer-switch mouse)
  base (layer-switch base)

  mh (movemouse-accel-left  3 800 1 10)
  mj (movemouse-accel-down  3 800 1 10)
  mk (movemouse-accel-up    3 800 1 10)
  ml (movemouse-accel-right 3 800 1 10)
  wu (mwheel-up   50 120)
  wd (mwheel-down 50 120)
  slo (movemouse-speed 25)
  fst (movemouse-speed 250)
)

(deflayer base
  @f1 @f2 _ _ _ _ @f7 @f8 @f9 @f10 @f11 @f12
  u
  @esc @a @s @d @f g h @j @k @l @sc
  n m
  @nav
)

(deflayer navigation
  _ _ _ _ _ _ _ _ _ _ _ _
  _
  _ _ _ _ _ _ left down up rght _
  _ @mse
  _
)

(deflayer mouse
  _ _ _ _ _ _ _ _ _ _ _ _
  @wu
  @base @slo mmid mrgt mlft @fst @mh @mj @mk @ml _
  @wd @base
  mlft
)
